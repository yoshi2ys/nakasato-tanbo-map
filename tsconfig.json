{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // ブラウザで動くコードなので、Node の型を紛れ込ませない。
    // 入れると process などが型検査を通ってしまい、実行時に ReferenceError になる。
    "types": []
  },
  "include": ["src"]
}
